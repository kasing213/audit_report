# Payment Tracker (receivables reminders).
#
# PAYMENT_TRACKER_DATABASE_URL must be a COLLECTION-SCOPED read-only credential:
# an Atlas custom role granting only `find` and `listIndexes` on
# ar_tracker.ar_state. MongoDB's built-in database-wide `read` role is broader
# than required and is rejected. The Payment-Tracker system's own atlasAdmin URI
# must never be copied here.
#
# Verify before enabling anything:
#   npx ts-node scripts/check-payment-tracker-source.ts
PAYMENT_TRACKER_DATABASE_URL=
PAYMENT_TRACKER_SCAN_ENABLED=false
PAYMENT_TRACKER_SCAN_TIME=10:00
PAYMENT_TRACKER_DAILY_CAP=15
