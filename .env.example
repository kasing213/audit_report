# Payment Tracker (receivables reminders).
#
# PAYMENT_TRACKER_DATABASE_URL must be a COLLECTION-SCOPED read-only credential:
# an Atlas custom role granting only `find` and `listIndexes` on
# ar_tracker.ar_state. MongoDB's built-in database-wide `read` role is broader
# than required and is rejected. The Payment-Tracker system's own atlasAdmin URI
# must never be copied here.
#
# Verify before enabling anything:
#   npx ts-node scripts/check-payment-tracker-source.ts
PAYMENT_TRACKER_DATABASE_URL=
PAYMENT_TRACKER_SCAN_ENABLED=false
PAYMENT_TRACKER_SCAN_TIME=10:00
PAYMENT_TRACKER_DAILY_CAP=15

# Lead Control reads the authoritative sales source through a separate,
# collection-scoped custom role. It must grant only find and listIndexes on
# ar_tracker.sales; database-wide read and all write/admin actions are rejected.
#
# This URI is credentials-only: Lead Control fixes the target to ar_tracker.sales
# in code. Do not put a payment-tracker administrator URI here.
LEAD_CONTROL_SALES_DATABASE_URL=

# Lead Control deploys in read-only comparison mode. Writes enable only for the
# exact value `true`, after boss confirmation and the rollout checks in
# docs/lead-control/operational-rollout.md.
LEAD_CONTROL_WRITES_ENABLED=false

# Sales synchronization is a separate exact opt-in. When false, Audit Sales
# registers no Lead Control cron and opens no connection to the sales source.
# When true, the collection-scoped credential above is validated before reads.
LEAD_CONTROL_SYNC_ENABLED=false

# Valid integer range: 5 through 60 minutes. Default: 15.
LEAD_CONTROL_SYNC_INTERVAL_MINUTES=15
