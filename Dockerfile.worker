# Outreach Telegram worker (MTProto / gramjs).
# Runs as a separate service alongside the API. Talks to Telegram's MTProto
# servers directly via the user account session; no headless browser. Persistent
# storage at /data is required so the StringSession blob survives redeploys.
FROM node:20-slim

# Minimal CA certificates so HTTPS to BASE_URL and Telegram's DCs works.
RUN apt-get update && apt-get install -y \
    ca-certificates \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/scripts/telegram-worker

COPY scripts/telegram-worker/package*.json ./
RUN npm install --omit=optional && npm cache clean --force

COPY scripts/telegram-worker/tsconfig.json ./
COPY scripts/telegram-worker/worker.ts ./
COPY scripts/telegram-worker/login-tg.ts ./

# /data is where the Railway volume mounts. The worker reads STRING_SESSION_PATH
# from this path so the Telegram session survives redeploys. Bootstrap the
# session locally with `npm run login` and copy the resulting file into /data.
VOLUME ["/data"]
ENV STRING_SESSION_PATH=/data/telegram-string-session.txt

CMD ["npx", "ts-node", "worker.ts"]
