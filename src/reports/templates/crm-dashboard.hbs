<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CRM Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0c0c0f;
      --surface: #16161a;
      --surface-2: #1e1e24;
      --border: #2a2a32;
      --text: #e8e6e3;
      --text-muted: #72717a;
      --accent: #00d4aa;
      --accent-dim: #00d4aa22;
      --red: #ff4d6a;
      --red-dim: #ff4d6a18;
      --yellow: #ffc145;
      --yellow-dim: #ffc14518;
      --green: #00d4aa;
      --green-dim: #00d4aa18;
      --telegram: #26a5e4;
      --font-body: 'Outfit', sans-serif;
      --font-mono: 'DM Mono', monospace;
      --radius: 8px;
    }

    html { font-size: 15px; }
    body {
      font-family: var(--font-body);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* HEADER */
    .header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.25rem;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(12px);
    }
    .header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }
    .logo {
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .logo-mark {
      width: 28px; height: 28px;
      background: var(--accent);
      border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.75rem; font-weight: 700; color: var(--bg);
    }
    .stats-bar {
      display: flex;
      gap: 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-muted);
    }
    .stat-val { color: var(--accent); font-weight: 500; }

    /* FILTERS */
    .filters {
      padding: 0.75rem 1.25rem;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }
    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .filter-label {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      font-weight: 500;
    }
    select, input[type="number"], input[type="text"] {
      font-family: var(--font-body);
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.45rem 0.65rem;
      border-radius: var(--radius);
      font-size: 0.85rem;
      outline: none;
      min-width: 0;
    }
    select:focus, input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--accent-dim);
    }
    select { cursor: pointer; padding-right: 1.5rem; }
    input[type="number"] { width: 70px; }
    input[type="text"] { width: 160px; }

    .btn {
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.45rem 1rem;
      border-radius: var(--radius);
      border: none;
      cursor: pointer;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .btn-primary {
      background: var(--accent);
      color: var(--bg);
    }
    .btn-primary:hover { opacity: 0.85; }
    .btn-ghost {
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border);
    }
    .btn-ghost:hover { border-color: var(--text-muted); }

    /* CUSTOMER TABLE */
    .table-wrap {
      padding: 0 0.5rem;
      overflow-x: auto;
    }
    .customer-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
    }
    .customer-table th {
      text-align: left;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      font-weight: 500;
      padding: 0.75rem 0.65rem;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
      position: sticky;
      top: 0;
      background: var(--bg);
    }
    .customer-table td {
      padding: 0.65rem;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    .customer-table tr:hover td {
      background: var(--surface);
    }

    .customer-name {
      font-weight: 600;
      white-space: nowrap;
    }
    .phone-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--telegram);
      text-decoration: none;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      padding: 0.25rem 0.5rem;
      background: #26a5e412;
      border-radius: var(--radius);
      border: 1px solid #26a5e425;
      transition: all 0.15s;
      white-space: nowrap;
    }
    .phone-link:hover {
      background: #26a5e422;
      border-color: var(--telegram);
    }
    .phone-link svg { flex-shrink: 0; }

    .tag {
      display: inline-block;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 500;
      white-space: nowrap;
    }
    .tag-stale-green { background: var(--green-dim); color: var(--green); }
    .tag-stale-yellow { background: var(--yellow-dim); color: var(--yellow); }
    .tag-stale-red { background: var(--red-dim); color: var(--red); }

    .note-text {
      color: var(--text-muted);
      font-size: 0.8rem;
      max-width: 180px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .events-count {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* EMPTY STATE */
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--text-muted);
    }
    .empty-state h3 { font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--text); }

    /* IMPORT SECTION */
    .import-section {
      padding: 1.25rem;
      border-top: 1px solid var(--border);
    }
    .import-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
      cursor: pointer;
    }
    .import-header h3 {
      font-size: 0.9rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .import-toggle {
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .import-body { display: none; }
    .import-body.open { display: block; }

    .drop-zone {
      border: 2px dashed var(--border);
      border-radius: var(--radius);
      padding: 2rem;
      text-align: center;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }
    .drop-zone:hover, .drop-zone.dragover {
      border-color: var(--accent);
      background: var(--accent-dim);
    }
    .drop-zone input { display: none; }

    .import-preview {
      margin-top: 1rem;
      background: var(--surface);
      border-radius: var(--radius);
      padding: 1rem;
      display: none;
    }
    .import-preview.show { display: block; }
    .import-preview h4 {
      font-size: 0.85rem;
      margin-bottom: 0.5rem;
    }
    .import-actions {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    /* LOADING */
    .loading {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem;
      color: var(--text-muted);
      gap: 0.5rem;
    }
    .spinner {
      width: 18px; height: 18px;
      border: 2px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* SEARCH */
    .search-wrap {
      position: relative;
      flex: 1;
      min-width: 140px;
    }
    .search-wrap input {
      width: 100%;
      padding-left: 2rem;
    }
    .search-wrap svg {
      position: absolute;
      left: 0.6rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
    }

    /* MOBILE CARDS */
    .mobile-cards { display: none; }

    @media (max-width: 768px) {
      html { font-size: 14px; }
      .table-wrap { display: none; }
      .mobile-cards { display: block; padding: 0.5rem; }

      .m-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 0.85rem;
        margin-bottom: 0.5rem;
      }
      .m-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
      }
      .m-card-name { font-weight: 600; font-size: 0.95rem; }
      .m-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.75rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
      }
      .m-card .phone-link {
        display: flex;
        width: 100%;
        justify-content: center;
        padding: 0.5rem;
        font-size: 0.9rem;
      }
      .filters {
        padding: 0.5rem 0.75rem;
        gap: 0.4rem;
      }
      .filter-group { flex: 1; min-width: 80px; }
      select, input { font-size: 0.8rem; padding: 0.4rem 0.5rem; }
    }

    /* TOAST */
    .toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.75rem 1.25rem;
      font-size: 0.85rem;
      z-index: 1000;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.3s;
    }
    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }
    .toast.success { border-color: var(--green); color: var(--green); }
    .toast.error { border-color: var(--red); color: var(--red); }
  </style>
</head>
<body>

<!-- HEADER -->
<div class="header">
  <div class="header-top">
    <div class="logo">
      <div class="logo-mark">CRM</div>
      Sales CRM
    </div>
    <div class="stats-bar">
      <span>Total: <span class="stat-val" id="stat-total">—</span></span>
      <span>Stale: <span class="stat-val" id="stat-stale" style="color:var(--red)">—</span></span>
      <a href="logout" style="color:var(--text-muted);text-decoration:none;font-size:0.75rem;margin-left:0.5rem">Logout</a>
    </div>
  </div>
</div>

<!-- FILTERS -->
<div class="filters">
  <div class="filter-group">
    <span class="filter-label">Follower</span>
    <select id="filter-follower">
      <option value="all">All</option>
      {{#each followers}}
      <option value="{{this}}">{{this}}</option>
      {{/each}}
    </select>
  </div>
  <div class="filter-group">
    <span class="filter-label">Filter</span>
    <select id="filter-type">
      <option value="all">All Customers</option>
      <option value="stale">Stale (No contact)</option>
      <option value="reason">By Reason</option>
    </select>
  </div>
  <div class="filter-group" id="reason-group" style="display:none">
    <span class="filter-label">Reason</span>
    <select id="filter-reason">
      {{#each reasonCodes}}
      <option value="{{this.code}}">{{this.code}} - {{this.label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="filter-group" id="days-group" style="display:none">
    <span class="filter-label">Days</span>
    <input type="number" id="filter-days" value="14" min="1" max="365">
  </div>
  <div class="filter-group search-wrap">
    <span class="filter-label">Search</span>
    <input type="text" id="search-input" placeholder="Name or phone...">
  </div>
  <div class="filter-group" style="justify-content:flex-end">
    <span class="filter-label">&nbsp;</span>
    <button class="btn btn-primary" onclick="loadCustomers()">Load</button>
  </div>
</div>

<!-- TABLE (desktop) -->
<div class="table-wrap">
  <table class="customer-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Name</th>
        <th>Phone / Telegram</th>
        <th>Page</th>
        <th>Follower</th>
        <th>Last Contact</th>
        <th>Reason</th>
        <th>Note</th>
        <th>Events</th>
      </tr>
    </thead>
    <tbody id="table-body">
    </tbody>
  </table>
</div>

<!-- CARDS (mobile) -->
<div class="mobile-cards" id="mobile-body"></div>

<!-- LOADING -->
<div class="loading" id="loading" style="display:none">
  <div class="spinner"></div>
  <span>Loading customers...</span>
</div>

<!-- EMPTY -->
<div class="empty-state" id="empty" style="display:none">
  <h3>No customers found</h3>
  <p>Try adjusting your filters or load a different follower.</p>
</div>

<!-- IMPORT SECTION -->
<div class="import-section">
  <div class="import-header" onclick="toggleImport()">
    <h3>
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
      Import CSV / Excel
    </h3>
    <span class="import-toggle" id="import-toggle-text">Show</span>
  </div>
  <div class="import-body" id="import-body">
    <div class="drop-zone" id="drop-zone" onclick="document.getElementById('file-input').click()">
      <input type="file" id="file-input" accept=".csv,.xlsx,.xls">
      <p>Click or drop a CSV/Excel file here</p>
      <p style="font-size:0.75rem;margin-top:0.25rem">Columns: phone (required), name, date, page, destination, follower, reason_code, note</p>
    </div>
    <div class="import-preview" id="import-preview">
      <h4>Preview: <span id="import-count">0</span> records</h4>
      <div style="overflow-x:auto;max-height:200px;font-size:0.8rem;font-family:var(--font-mono)" id="import-preview-table"></div>
      <div class="import-actions">
        <button class="btn btn-primary" onclick="confirmImport()">Confirm Import</button>
        <button class="btn btn-ghost" onclick="cancelImport()">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
  const API_BASE = window.location.pathname.replace(/\/$/, '');
  let allCustomers = [];
  let importRows = null;

  // FILTER UI
  document.getElementById('filter-type').addEventListener('change', function() {
    document.getElementById('reason-group').style.display = this.value === 'reason' ? '' : 'none';
    document.getElementById('days-group').style.display = this.value === 'stale' ? '' : 'none';
  });

  // SEARCH
  document.getElementById('search-input').addEventListener('input', function() {
    renderCustomers(filterBySearch(allCustomers, this.value));
  });

  function filterBySearch(customers, query) {
    if (!query) return customers;
    const q = query.toLowerCase();
    return customers.filter(c =>
      (c.name && c.name.toLowerCase().includes(q)) ||
      (c.phone && c.phone.includes(q)) ||
      (c.phone_display && c.phone_display.includes(q))
    );
  }

  // LOAD
  async function loadCustomers() {
    const follower = document.getElementById('filter-follower').value;
    const filter = document.getElementById('filter-type').value;
    const reason = document.getElementById('filter-reason').value;
    const days = document.getElementById('filter-days').value;

    let url = API_BASE + '/api/customers?filter=' + filter;
    if (follower !== 'all') url += '&follower=' + encodeURIComponent(follower);
    if (filter === 'reason') url += '&reason=' + encodeURIComponent(reason);
    if (filter === 'stale') url += '&days=' + days;

    document.getElementById('loading').style.display = '';
    document.getElementById('empty').style.display = 'none';
    document.getElementById('table-body').innerHTML = '';
    document.getElementById('mobile-body').innerHTML = '';

    try {
      const resp = await fetch(url, { credentials: 'same-origin' });
      if (resp.status === 401) { window.location.href = API_BASE + '/login'; return; }
      const data = await resp.json();
      allCustomers = data.customers || [];

      document.getElementById('stat-total').textContent = allCustomers.length;
      const staleCount = allCustomers.filter(c => c.days_since_contact > 14).length;
      document.getElementById('stat-stale').textContent = staleCount;

      const query = document.getElementById('search-input').value;
      renderCustomers(filterBySearch(allCustomers, query));
    } catch (err) {
      showToast('Failed to load customers', 'error');
    }
    document.getElementById('loading').style.display = 'none';
  }

  function staleTag(days) {
    if (days === null || days === undefined) return '<span class="tag tag-stale-green">New</span>';
    if (days <= 7) return '<span class="tag tag-stale-green">' + days + 'd</span>';
    if (days <= 14) return '<span class="tag tag-stale-yellow">' + days + 'd</span>';
    return '<span class="tag tag-stale-red">' + days + 'd</span>';
  }

  function telegramSvg() {
    return '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>';
  }

  function renderCustomers(customers) {
    const tbody = document.getElementById('table-body');
    const mobileBody = document.getElementById('mobile-body');

    if (customers.length === 0) {
      tbody.innerHTML = '';
      mobileBody.innerHTML = '';
      document.getElementById('empty').style.display = '';
      return;
    }
    document.getElementById('empty').style.display = 'none';

    // Desktop table
    tbody.innerHTML = customers.map((c, i) => {
      const phoneCell = c.telegram_link
        ? '<a class="phone-link" href="' + c.telegram_link + '" target="_blank">' + telegramSvg() + ' ' + (c.phone_display || c.phone) + '</a>'
        : (c.phone || '—');
      return '<tr>' +
        '<td>' + (i+1) + '</td>' +
        '<td class="customer-name">' + (c.name || 'Unknown') + '</td>' +
        '<td>' + phoneCell + '</td>' +
        '<td>' + (c.page || '—') + '</td>' +
        '<td>' + (c.follower || '—') + '</td>' +
        '<td>' + staleTag(c.days_since_contact) + ' ' + (c.last_update_date || '—') + '</td>' +
        '<td>' + (c.current_reason_code ? '<span class="tag">' + c.current_reason_code + '</span>' : '—') + '</td>' +
        '<td><span class="note-text">' + (c.latest_note || c.history?.[c.history.length-1]?.note || '—') + '</span></td>' +
        '<td class="events-count">' + (c.total_events || 0) + '</td>' +
        '</tr>';
    }).join('');

    // Mobile cards
    mobileBody.innerHTML = customers.map(c => {
      const phoneBtn = c.telegram_link
        ? '<a class="phone-link" href="' + c.telegram_link + '" target="_blank">' + telegramSvg() + ' Chat on Telegram: ' + (c.phone_display || c.phone) + '</a>'
        : '';
      return '<div class="m-card">' +
        '<div class="m-card-top"><span class="m-card-name">' + (c.name || 'Unknown') + '</span>' + staleTag(c.days_since_contact) + '</div>' +
        '<div class="m-card-meta">' +
          '<span>' + (c.page || '') + '</span>' +
          '<span>' + (c.follower || '') + '</span>' +
          '<span>' + (c.last_update_date || '') + '</span>' +
          (c.current_reason_code ? '<span class="tag">' + c.current_reason_code + '</span>' : '') +
        '</div>' +
        phoneBtn +
        '</div>';
    }).join('');
  }

  // IMPORT
  function toggleImport() {
    const body = document.getElementById('import-body');
    const text = document.getElementById('import-toggle-text');
    if (body.classList.contains('open')) {
      body.classList.remove('open');
      text.textContent = 'Show';
    } else {
      body.classList.add('open');
      text.textContent = 'Hide';
    }
  }

  // Drag & drop
  const dropZone = document.getElementById('drop-zone');
  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer.files.length) uploadFile(e.dataTransfer.files[0]);
  });
  document.getElementById('file-input').addEventListener('change', function() {
    if (this.files.length) uploadFile(this.files[0]);
  });

  async function uploadFile(file) {
    const formData = new FormData();
    formData.append('file', file);

    try {
      const resp = await fetch(API_BASE + '/api/import', {
        method: 'POST',
        credentials: 'same-origin',
        body: formData
      });
      if (resp.status === 401) { window.location.href = API_BASE + '/login'; return; }
      const data = await resp.json();

      if (data.error) {
        showToast(data.error, 'error');
        return;
      }

      importRows = data.rows;
      document.getElementById('import-count').textContent = data.total;

      // Build preview table
      const headers = data.headers || [];
      const sample = data.sample || [];
      let html = '<table style="width:100%;border-collapse:collapse"><thead><tr>';
      headers.forEach(h => html += '<th style="padding:0.25rem 0.5rem;border-bottom:1px solid var(--border);text-align:left">' + h + '</th>');
      html += '</tr></thead><tbody>';
      sample.forEach(row => {
        html += '<tr>';
        headers.forEach(h => html += '<td style="padding:0.25rem 0.5rem;border-bottom:1px solid var(--border)">' + (row[h] || '') + '</td>');
        html += '</tr>';
      });
      if (data.total > 5) html += '<tr><td colspan="' + headers.length + '" style="padding:0.25rem 0.5rem;color:var(--text-muted)">... and ' + (data.total - 5) + ' more rows</td></tr>';
      html += '</tbody></table>';

      document.getElementById('import-preview-table').innerHTML = html;
      document.getElementById('import-preview').classList.add('show');
    } catch (err) {
      showToast('Failed to upload file', 'error');
    }
  }

  async function confirmImport() {
    if (!importRows) return;
    try {
      const resp = await fetch(API_BASE + '/api/import/confirm', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rows: importRows })
      });
      if (resp.status === 401) { window.location.href = API_BASE + '/login'; return; }
      const data = await resp.json();
      if (data.success) {
        showToast('Imported ' + data.imported + ' records' + (data.skipped ? ', skipped ' + data.skipped : ''), 'success');
        cancelImport();
        loadCustomers();
      } else {
        showToast(data.error || 'Import failed', 'error');
      }
    } catch (err) {
      showToast('Import failed', 'error');
    }
  }

  function cancelImport() {
    importRows = null;
    document.getElementById('import-preview').classList.remove('show');
    document.getElementById('file-input').value = '';
  }

  // TOAST
  function showToast(msg, type) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.className = 'toast ' + type + ' show';
    setTimeout(() => toast.classList.remove('show'), 3000);
  }

  // Initial load
  loadCustomers();
</script>
</body>
</html>
