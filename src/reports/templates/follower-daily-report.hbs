<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <title>{{follower}} - {{date}}</title>
    <style>
        body {
            font-family: 'Noto Sans Khmer', 'Khmer OS', 'Khmer UI', Arial, sans-serif;
            margin: 0;
            padding: 16px;
            background-color: #f5f5f5;
            font-size: 17px;
            color: #222;
        }
        .container {
            background-color: white;
            padding: 22px 24px;
            border-radius: 8px;
        }
        .header {
            border-bottom: 3px solid #007bff;
            padding-bottom: 12px;
            margin-bottom: 16px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }
        .header h1 { color: #007bff; margin: 0; font-size: 32px; }
        .header .date { color: #444; font-size: 20px; text-align: right; }
        .header .part { color: #888; font-size: 16px; }
        .totals { font-size: 19px; margin-bottom: 18px; }
        .totals b { color: #007bff; }
        .section { margin-top: 18px; }
        .section h2 {
            margin: 0 0 8px 0;
            font-size: 22px;
            padding: 6px 12px;
            border-radius: 5px;
            color: white;
        }
        .followups h2 { background-color: #007bff; }
        .closings h2 { background-color: #1e8e3e; }
        .section h2 .count { float: right; font-weight: normal; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 8px 10px; text-align: left; vertical-align: top; }
        th { background-color: #eef3fb; font-size: 16px; }
        .closings th { background-color: #e8f5ec; }
        tr:nth-child(even) td { background-color: #fafafa; }
        td.num { text-align: right; white-space: nowrap; }
        td.time { white-space: nowrap; }
        .booked { color: #1e8e3e; font-weight: bold; }
        .tag { font-size: 13px; background: #fff3cd; border: 1px solid #e0c060; border-radius: 3px; padding: 0 4px; }
        .none { color: #777; font-style: italic; padding: 6px 2px; }
        .counts h2 { background-color: #6c4fc2; }
        .counts .grid { display: flex; gap: 14px; align-items: flex-start; }
        .counts table { font-size: 15px; }
        .counts td, .counts th { padding: 4px 8px; }
        .counts .a { flex: 0 0 44%; }
        .counts .b { flex: 1; }
        .counts .b th, .counts .b td.num { text-align: center; }
        .counts td.zero { color: #aaa; }
        /* Repeat numbers: after the zebra rule so the colour wins. */
        tr.dupe-yellow td { background-color: #fff3b0; }
        tr.dupe-red td { background-color: #ffc9c9; }
        .dupe { font-size: 13px; font-weight: bold; border-radius: 3px; padding: 0 4px; margin-left: 4px; }
        tr.dupe-yellow .dupe { background: #e0b000; color: #222; }
        tr.dupe-red .dupe { background: #c62828; color: white; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>{{follower}}</h1>
        <div class="date">
            Follower · {{date}}
            {{#if multiPage}}<div class="part">Page {{page}}/{{pages}}</div>{{/if}}
        </div>
    </div>

    {{#if showCounts}}
    <div class="section counts">
        <h2>Report counts</h2>
        <div class="grid">
            <table class="a">
                <thead><tr><th>A. Follow (Boots Page)</th><th></th></tr></thead>
                <tbody>
                    {{#each counts.sectionA}}
                    <tr><td>{{this.label}}</td><td class="num {{#unless this.value}}zero{{/unless}}">{{this.value}}</td></tr>
                    {{/each}}
                </tbody>
            </table>
            <table class="b">
                <thead>
                    <tr><th style="text-align:left">B. Connected by</th><th>Total</th><th>message</th><th>telegram</th><th>phone</th><th>other</th></tr>
                </thead>
                <tbody>
                    {{#each counts.channels}}
                    <tr>
                        <td style="text-align:left">{{this.label}}</td>
                        <td class="num {{#unless this.total}}zero{{/unless}}"><b>{{this.total}}</b></td>
                        {{#each this.by}}<td class="num {{#unless this}}zero{{/unless}}">{{this}}</td>{{/each}}
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    {{/if}}

    {{#if showFollowUps}}
    <div class="section followups">
        <h2>1 · Follow-ups</h2>
        <div class="totals">
            Messages: <b>{{totalMessagesShown}}</b> &nbsp;·&nbsp;
            Gave a number: <b>{{totalWithNumber}}</b>
            &nbsp;·&nbsp; Message only (no number): <b>{{totalMessageOnlyShown}}</b>
        </div>
        {{#if followUpRows.length}}
        <table>
            <thead>
                <tr><th>#</th><th>Time</th><th>Customer Name</th><th>Phone Number</th><th>Platform/Page</th><th>Reason</th></tr>
            </thead>
            <tbody>
                {{#each followUpRows}}
                <tr{{#if this.flag}} class="dupe-{{this.flag}}"{{/if}}>
                    <td class="num">{{this.n}}</td>
                    <td class="time">{{this.time}}</td>
                    <td>{{this.name}}</td>
                    <td>{{this.phone}}{{#if this.flag}}<span class="dupe">{{this.flagLabel}}</span>{{/if}}</td>
                    <td>{{this.page}}</td>
                    <td>{{this.reason}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{else}}
        <div class="none">No numbers given.</div>
        {{/if}}
    </div>
    {{/if}}

    {{#if showClosings}}
    <div class="section closings">
        <h2>2 · Closing <span class="count">{{totalClosings}}</span></h2>
        <div class="totals">Booked: <b>{{totalBooked}}</b> &nbsp;·&nbsp; Not booked: <b>{{totalNotBooked}}</b></div>
        {{#if closingRows.length}}
        <table>
            <thead>
                <tr><th>#</th><th>Time</th><th>Phone Number</th><th>Platform/Page</th><th>Closer</th><th>Booked</th><th>Not booked</th><th>Result</th></tr>
            </thead>
            <tbody>
                {{#each closingRows}}
                <tr>
                    <td class="num">{{this.n}}</td>
                    <td class="time">{{this.time}}</td>
                    <td>{{this.phone}}</td>
                    <td>{{this.page}}</td>
                    <td>{{this.closer}}</td>
                    <td class="num {{#if this.booked}}booked{{/if}}">{{this.booked}}</td>
                    <td class="num">{{this.not_booked}}</td>
                    <td>{{#if this.potential}}<span class="tag">Potential</span> {{/if}}{{this.reason}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{else}}
        <div class="none">No closing sales.</div>
        {{/if}}
    </div>
    {{/if}}
</div>
</body>
</html>
