{{> head title="Sales CRM — Customers"}}
{{> nav activeNav="customers" showStats=true}}

<!-- FILTERS -->
<div class="filters">
  <div class="filter-group">
    <span class="filter-label">Follower</span>
    <select id="filter-follower">
      <option value="all">All</option>
      {{#each followers}}
      <option value="{{this}}">{{this}}</option>
      {{/each}}
    </select>
  </div>
  <div class="filter-group">
    <span class="filter-label">Filter</span>
    <select id="filter-type">
      <option value="all">All Customers</option>
      <option value="stale">Stale (No contact)</option>
      <option value="reason">By Reason</option>
    </select>
  </div>
  <div class="filter-group" id="reason-group" style="display:none">
    <span class="filter-label">Reason</span>
    <select id="filter-reason">
      {{#each reasonCodes}}
      <option value="{{this.code}}">{{this.code}} - {{this.label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="filter-group" id="days-group" style="display:none">
    <span class="filter-label">Days</span>
    <input type="number" id="filter-days" value="14" min="1" max="365">
  </div>
  <div class="filter-group">
    <span class="filter-label">Temp</span>
    <select id="filter-temperature">
      <option value="">All</option>
      <option value="hot">🔥 Hot</option>
      <option value="warm">🌤️ Warm</option>
      <option value="cold">❄️ Cold</option>
    </select>
  </div>
  <div class="filter-group search-wrap">
    <span class="filter-label">Search</span>
    <input type="text" id="search-input" placeholder="Name or phone...">
  </div>
  <div class="filter-group" style="justify-content:flex-end">
    <span class="filter-label">&nbsp;</span>
    <button class="btn btn-primary" onclick="loadCustomers()">Load</button>
  </div>
</div>

<!-- TABLE (desktop) -->
<div class="table-wrap">
  <table class="customer-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Name</th>
        <th>Phone / Telegram</th>
        <th>Page</th>
        <th>Follower</th>
        <th>Last Contact</th>
        <th>Temp</th>
        <th>Reason</th>
        <th>Note</th>
        <th>Events</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="table-body">
    </tbody>
  </table>
</div>
<style>
  .del-btn, .edit-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 6px;
    padding: 0.2rem 0.55rem;
    font-size: 0.75rem;
    cursor: pointer;
    font-family: var(--font-body);
    transition: all 0.15s;
  }
  .del-btn:hover { border-color: var(--red); color: var(--red); }
  .edit-btn:hover { border-color: var(--accent); color: var(--accent); }
  .row-actions { display: inline-flex; gap: 0.35rem; }
  .m-card-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .m-card-del { display: inline-flex; align-items: center; gap: 0.25rem; }

  /* Edit modal */
  .edit-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    display: none;
    align-items: flex-start;
    justify-content: center;
    z-index: 1000;
    overflow-y: auto;
    padding: 1.5rem 1rem;
  }
  .edit-modal-backdrop.open { display: flex; }
  .edit-modal {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    width: 100%;
    max-width: 560px;
    padding: 1.1rem 1.1rem 1.4rem;
    color: var(--text);
    font-family: var(--font-body);
  }
  .edit-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }
  .edit-modal-title { font-size: 1rem; font-weight: 600; }
  .edit-modal-close {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1.2rem;
    cursor: pointer;
    line-height: 1;
  }
  .edit-modal-close:hover { color: var(--text); }
  .edit-event-list { display: flex; flex-direction: column; gap: 0.4rem; }
  .edit-event-row {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 0.55rem 0.7rem;
    cursor: pointer;
    transition: border-color 0.15s;
    font-size: 0.82rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .edit-event-row:hover { border-color: var(--accent); }
  .edit-event-row .ev-top { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .edit-event-row .ev-date { font-family: var(--font-mono); color: var(--accent); }
  .edit-event-row .ev-meta { color: var(--text-muted); font-size: 0.78rem; }
  .edit-event-row .ev-note { color: var(--text); font-size: 0.78rem; }
  .edit-form-row { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.85rem; }
  .edit-form-row label { font-size: 0.78rem; color: var(--text-muted); }
  .edit-form-row select,
  .edit-form-row input,
  .edit-form-row textarea {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 6px;
    padding: 0.45rem 0.6rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
  }
  .edit-form-row textarea { resize: vertical; min-height: 70px; }
  .edit-form-actions { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 0.4rem; }
  .edit-back-btn {
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.4rem 0.85rem;
    cursor: pointer;
    font-size: 0.8rem;
  }
  .edit-back-btn:hover { color: var(--text); border-color: var(--text-muted); }
  .edit-modal-empty { color: var(--text-muted); font-size: 0.85rem; padding: 0.5rem; }
</style>

<!-- Edit modal -->
<div class="edit-modal-backdrop" id="edit-modal" role="dialog" aria-modal="true">
  <div class="edit-modal">
    <div class="edit-modal-header">
      <span class="edit-modal-title" id="edit-modal-title">Edit customer</span>
      <button class="edit-modal-close" onclick="closeEditModal()" aria-label="Close">×</button>
    </div>
    <div id="edit-modal-body"></div>
  </div>
</div>

<!-- CARDS (mobile) -->
<div class="mobile-cards" id="mobile-body"></div>

<!-- LOADING -->
<div class="loading" id="loading" style="display:none">
  <div class="spinner"></div>
  <span>Loading customers...</span>
</div>

<!-- EMPTY -->
<div class="empty-state" id="empty" style="display:none">
  <h3>No customers found</h3>
  <p>Try adjusting your filters or load a different follower.</p>
</div>

<script>
  const API_BASE = '/crm';
  let allCustomers = [];

  document.getElementById('filter-type').addEventListener('change', function() {
    document.getElementById('reason-group').style.display = this.value === 'reason' ? '' : 'none';
    document.getElementById('days-group').style.display = this.value === 'stale' ? '' : 'none';
  });

  document.getElementById('search-input').addEventListener('input', function() {
    renderCustomers(filterBySearch(allCustomers, this.value));
  });

  function filterBySearch(customers, query) {
    if (!query) return customers;
    const q = query.toLowerCase();
    return customers.filter(c =>
      (c.name && c.name.toLowerCase().includes(q)) ||
      (c.phone && c.phone.includes(q)) ||
      (c.phone_display && c.phone_display.includes(q))
    );
  }

  async function loadCustomers() {
    const follower = document.getElementById('filter-follower').value;
    const filter = document.getElementById('filter-type').value;
    const reason = document.getElementById('filter-reason').value;
    const days = document.getElementById('filter-days').value;
    const temperature = document.getElementById('filter-temperature').value;

    let url = API_BASE + '/api/customers?filter=' + filter;
    if (follower !== 'all') url += '&follower=' + encodeURIComponent(follower);
    if (filter === 'reason') url += '&reason=' + encodeURIComponent(reason);
    if (filter === 'stale') url += '&days=' + days;
    if (temperature) url += '&temperature=' + temperature;

    document.getElementById('loading').style.display = '';
    document.getElementById('empty').style.display = 'none';
    document.getElementById('table-body').innerHTML = '';
    document.getElementById('mobile-body').innerHTML = '';

    try {
      const resp = await fetch(url, { credentials: 'same-origin' });
      if (resp.status === 401) { window.location.href = '/login'; return; }
      const data = await resp.json();
      allCustomers = data.customers || [];

      document.getElementById('stat-total').textContent = allCustomers.length;
      const staleCount = allCustomers.filter(c => c.days_since_contact > 14).length;
      document.getElementById('stat-stale').textContent = staleCount;

      const query = document.getElementById('search-input').value;
      renderCustomers(filterBySearch(allCustomers, query));
    } catch (err) {
      showToast('Failed to load customers', 'error');
    }
    document.getElementById('loading').style.display = 'none';
  }

  function staleTag(days) {
    if (days === null || days === undefined) return '<span class="tag tag-stale-green">New</span>';
    if (days <= 7) return '<span class="tag tag-stale-green">' + days + 'd</span>';
    if (days <= 14) return '<span class="tag tag-stale-yellow">' + days + 'd</span>';
    return '<span class="tag tag-stale-red">' + days + 'd</span>';
  }

  function tempTag(t) {
    if (!t) return '<span style="color:var(--text-muted)">—</span>';
    const emoji = t === 'hot' ? '🔥' : t === 'warm' ? '🌤️' : '❄️';
    return '<span class="tag tag-temp-' + t + '">' + emoji + ' ' + t + '</span>';
  }

  function telegramSvg() {
    return '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>';
  }

  function renderCustomers(customers) {
    const tbody = document.getElementById('table-body');
    const mobileBody = document.getElementById('mobile-body');

    if (customers.length === 0) {
      tbody.innerHTML = '';
      mobileBody.innerHTML = '';
      document.getElementById('empty').style.display = '';
      return;
    }
    document.getElementById('empty').style.display = 'none';

    tbody.innerHTML = customers.map((c, i) => {
      const phoneCell = c.telegram_link
        ? '<a class="phone-link" href="' + c.telegram_link + '" target="_blank">' + telegramSvg() + ' ' + (c.phone_display || c.phone) + '</a>'
        : (c.phone || '—');
      const safeName = (c.name || 'Unknown').replace(/'/g, "\\'");
      const actions = c.phone
        ? '<div class="row-actions">' +
            '<button class="edit-btn" onclick="openEditModal(\'' + encodeURIComponent(c.phone) + '\',\'' + safeName + '\')">Edit</button>' +
            '<button class="del-btn" onclick="deleteCustomer(\'' + encodeURIComponent(c.phone) + '\',\'' + safeName + '\')">Delete</button>' +
          '</div>'
        : '—';
      return '<tr>' +
        '<td>' + (i+1) + '</td>' +
        '<td class="customer-name">' + (c.name || 'Unknown') + '</td>' +
        '<td>' + phoneCell + '</td>' +
        '<td>' + (c.page || '—') + '</td>' +
        '<td>' + (c.follower || '—') + '</td>' +
        '<td>' + staleTag(c.days_since_contact) + ' ' + (c.last_update_date || '—') + '</td>' +
        '<td>' + tempTag(c.temperature) + '</td>' +
        '<td>' + (c.current_reason_code ? '<span class="tag">' + c.current_reason_code + '</span>' : '—') + '</td>' +
        '<td><span class="note-text">' + (c.latest_note || c.history?.[c.history.length-1]?.note || '—') + '</span></td>' +
        '<td class="events-count">' + (c.total_events || 0) + '</td>' +
        '<td>' + actions + '</td>' +
        '</tr>';
    }).join('');

    mobileBody.innerHTML = customers.map(c => {
      const phoneBtn = c.telegram_link
        ? '<a class="phone-link" href="' + c.telegram_link + '" target="_blank">' + telegramSvg() + ' Chat on Telegram: ' + (c.phone_display || c.phone) + '</a>'
        : '';
      const safeName = (c.name || 'Unknown').replace(/'/g, "\\'");
      const actions = c.phone
        ? '<div class="m-card-actions">' +
            '<button class="edit-btn" onclick="openEditModal(\'' + encodeURIComponent(c.phone) + '\',\'' + safeName + '\')">Edit</button>' +
            '<button class="del-btn m-card-del" onclick="deleteCustomer(\'' + encodeURIComponent(c.phone) + '\',\'' + safeName + '\')">Delete</button>' +
          '</div>'
        : '';
      return '<div class="m-card">' +
        '<div class="m-card-top"><span class="m-card-name">' + (c.name || 'Unknown') + '</span>' + staleTag(c.days_since_contact) + '</div>' +
        '<div class="m-card-meta">' +
          '<span>' + (c.page || '') + '</span>' +
          '<span>' + (c.follower || '') + '</span>' +
          '<span>' + (c.last_update_date || '') + '</span>' +
          (c.temperature ? tempTag(c.temperature) : '') +
          (c.current_reason_code ? '<span class="tag">' + c.current_reason_code + '</span>' : '') +
        '</div>' +
        phoneBtn +
        actions +
        '</div>';
    }).join('');
  }

  async function deleteCustomer(encodedPhone, name) {
    if (!confirm('Delete "' + name + '"? All events for this phone will be soft-deleted. This can be reversed only from the database.')) return;
    try {
      const resp = await fetch(API_BASE + '/api/customers/' + encodedPhone, {
        method: 'DELETE',
        credentials: 'same-origin',
      });
      if (resp.status === 401) { window.location.href = '/login'; return; }
      const data = await resp.json();
      if (resp.ok && data.success) {
        showToast('Deleted ' + name + ' (' + data.events_deleted + ' events)', 'success');
        loadCustomers();
      } else {
        showToast(data.error || 'Delete failed', 'error');
      }
    } catch (err) {
      showToast('Delete failed', 'error');
    }
  }

  // ---- Edit modal ----
  const REASON_CODES_LIST = {{{reasonCodesJson}}};
  const editModal = document.getElementById('edit-modal');
  const editBody = document.getElementById('edit-modal-body');
  const editTitle = document.getElementById('edit-modal-title');

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function closeEditModal() {
    editModal.classList.remove('open');
    editBody.innerHTML = '';
    document.body.style.overflow = '';
  }

  editModal.addEventListener('click', function(e) {
    if (e.target === editModal) closeEditModal();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && editModal.classList.contains('open')) closeEditModal();
  });

  let _eventsCache = [];
  let editingEvent = null;

  async function openEditModal(encodedPhone, name) {
    editTitle.textContent = 'Edit — ' + name;
    editBody.innerHTML = '<div class="edit-modal-empty">Loading events…</div>';
    editModal.classList.add('open');
    document.body.style.overflow = 'hidden';

    const phone = decodeURIComponent(encodedPhone);
    const today = new Date().toISOString().slice(0, 10);
    const params = new URLSearchParams({
      start: '2020-01-01',
      end: today,
      phone: phone,
    });
    try {
      const resp = await fetch('/data-entry/api/events?' + params.toString(), { credentials: 'same-origin' });
      if (resp.status === 401) { window.location.href = '/login'; return; }
      const data = await resp.json();
      const events = (data.events || []).slice().sort(function(a, b) {
        return (b.date || '').localeCompare(a.date || '');
      });
      _eventsCache = events;
      renderEventList();
    } catch (err) {
      editBody.innerHTML = '<div class="edit-modal-empty">Failed to load events.</div>';
    }
  }

  function renderEventList() {
    if (!_eventsCache.length) {
      editBody.innerHTML = '<div class="edit-modal-empty">No events for this customer.</div>';
      return;
    }
    const rows = _eventsCache.map(function(e) {
      const date = escapeHtml(e.date || '');
      const reason = e.reason_code ? '<span class="tag">' + escapeHtml(e.reason_code) + '</span>' : '';
      const page = escapeHtml(e.page || '');
      const follower = escapeHtml(e.follower || '');
      const note = escapeHtml((e.note || '').slice(0, 80));
      const promise = e.promise_date ? '📅 ' + escapeHtml(e.promise_date) : '';
      const id = escapeHtml(e._id);
      return '<div class="edit-event-row" onclick="openEditForm(\'' + id + '\')">' +
        '<div class="ev-top"><span class="ev-date">' + date + '</span>' + reason + (promise ? ' <span class="ev-meta">' + promise + '</span>' : '') + '</div>' +
        (page || follower ? '<div class="ev-meta">' + [page, follower].filter(Boolean).join(' · ') + '</div>' : '') +
        (note ? '<div class="ev-note">' + note + '</div>' : '') +
        '</div>';
    }).join('');
    editBody.innerHTML = '<div class="edit-event-list">' + rows + '</div>';
  }

  async function openEditForm(eventId) {
    editBody.innerHTML = '<div class="edit-modal-empty">Loading event…</div>';
    try {
      const resp = await fetch('/data-entry/api/events/' + encodeURIComponent(eventId), { credentials: 'same-origin' });
      if (resp.status === 401) { window.location.href = '/login'; return; }
      if (!resp.ok) {
        editBody.innerHTML = '<div class="edit-modal-empty">Failed to load event.</div>';
        return;
      }
      const data = await resp.json();
      editingEvent = data.event;
      renderEditForm(editingEvent);
    } catch (err) {
      editBody.innerHTML = '<div class="edit-modal-empty">Failed to load event.</div>';
    }
  }

  function renderEditForm(ev) {
    const reason = ev.reason_code || '';
    const note = ev.note || '';
    const promiseDate = ev.promise_date || '';
    const reasonOptions = ['<option value="">— None —</option>'].concat(
      REASON_CODES_LIST.map(function(r) {
        const sel = r.code === reason ? ' selected' : '';
        return '<option value="' + escapeHtml(r.code) + '"' + sel + '>' + escapeHtml(r.code) + ' — ' + escapeHtml(r.label) + '</option>';
      })
    ).join('');
    const customerName = (ev.customer && (ev.customer.name || ev.customer.phone)) || '';
    editBody.innerHTML =
      '<div class="edit-modal-empty" style="margin-bottom:0.6rem">Event ' + escapeHtml(ev.date || '') + ' · ' + escapeHtml(customerName) + '</div>' +
      '<div class="edit-form-row">' +
        '<label for="edit-reason">Reason code</label>' +
        '<select id="edit-reason">' + reasonOptions + '</select>' +
      '</div>' +
      '<div class="edit-form-row">' +
        '<label for="edit-note">Note</label>' +
        '<textarea id="edit-note">' + escapeHtml(note) + '</textarea>' +
      '</div>' +
      '<div class="edit-form-row">' +
        '<label for="edit-promise">Promise date</label>' +
        '<input type="date" id="edit-promise" value="' + escapeHtml(promiseDate) + '">' +
      '</div>' +
      '<div class="edit-form-actions">' +
        '<button class="edit-back-btn" onclick="renderEventList()">Back</button>' +
        '<button class="btn btn-primary" onclick="submitEdit()">Save</button>' +
      '</div>';
  }

  async function submitEdit() {
    if (!editingEvent) return;
    const reason = document.getElementById('edit-reason').value || null;
    const note = document.getElementById('edit-note').value || null;
    const promise = document.getElementById('edit-promise').value || null;

    const payload = {};
    if (reason !== (editingEvent.reason_code || null)) payload.reason_code = reason;
    if (note !== (editingEvent.note || null)) payload.note = note;
    if (promise !== (editingEvent.promise_date || null)) payload.promise_date = promise;

    if (Object.keys(payload).length === 0) {
      showToast('No changes', 'info');
      return;
    }

    try {
      const resp = await fetch('/data-entry/api/events/' + encodeURIComponent(editingEvent._id), {
        method: 'PUT',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (resp.status === 401) { window.location.href = '/login'; return; }
      const data = await resp.json();
      if (resp.ok && data.success) {
        showToast('Saved (' + (data.changes || 0) + ' field' + (data.changes === 1 ? '' : 's') + ')', 'success');
        closeEditModal();
        loadCustomers();
      } else {
        showToast(data.error || 'Save failed', 'error');
      }
    } catch (err) {
      showToast('Save failed', 'error');
    }
  }

  loadCustomers();
</script>

{{> footer}}
