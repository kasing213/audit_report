  const SCHEDULE_SETTINGS_URL = API + '/scheduler/settings';

  function renderOutreachSchedule(data) {
    const input = document.getElementById('outreach-daily-time');
    const help = document.getElementById('outreach-schedule-help');
    const clock = document.querySelector('#outreach-schedule-card .schedule-clock');
    const time = data.daily_time || '';
    const timezoneLabel = data.timezone === 'Asia/Phnom_Penh'
      ? 'Cambodia time'
      : (data.timezone || 'configured timezone');
    input.value = time;
    clock.textContent = time ? time.slice(0, 2) : '--';
    if (!time) {
      help.textContent = 'The current cron is not a single daily time. Choose a time to replace it for both sending numbers.';
    } else if (data.enabled) {
      help.textContent = timezoneLabel + ' · applies to Company and Personal · active now';
    } else {
      help.textContent = timezoneLabel + ' · saved for both sending numbers · auto-scan is disabled';
    }
