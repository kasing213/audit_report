  async function saveOutreachSchedule() {
    const input = document.getElementById('outreach-daily-time');
    const button = document.getElementById('outreach-schedule-save');
    if (!/^\d{2}:\d{2}$/.test(input.value)) {
      showToast('Choose a valid daily outreach time', 'error');
      return;
    }

    button.disabled = true;
    button.textContent = 'Saving…';
    try {
      const resp = await fetch(SCHEDULE_SETTINGS_URL, {
        method: 'PUT',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ daily_time: input.value }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok) throw new Error(data.error || ('Save failed: ' + resp.status));
      renderOutreachSchedule(data);
      const timezoneLabel = data.timezone === 'Asia/Phnom_Penh' ? 'Cambodia time' : data.timezone;
