    const help = document.getElementById('outreach-schedule-help');
    try {
      const resp = await fetch(SCHEDULE_SETTINGS_URL, { credentials: 'same-origin' });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok) throw new Error(data.error || ('Load failed: ' + resp.status));
      renderOutreachSchedule(data);
    } catch (err) {
