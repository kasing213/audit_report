{{> head title="Sales CRM — Outreach"}}
{{> nav activeNav="outreach"}}

<style>
  .outreach-wrap { padding: 1.25rem; max-width: 1200px; margin: 0 auto; }
  .outreach-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .status-tabs { display: flex; gap: 0.25rem; flex-wrap: wrap; }
  .status-tab {
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.15s;
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .status-tab:hover { color: var(--text); border-color: var(--text-muted); }
  .status-tab.active { color: var(--accent); border-color: var(--accent); background: var(--accent-dim); }
  .status-tab .count {
    background: var(--surface-2);
    border-radius: 10px;
    padding: 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .status-tab.active .count { background: var(--bg); color: var(--accent); }

  .generate-bar { display: flex; gap: 0.5rem; align-items: center; }

  .proposal {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    margin-bottom: 0.75rem;
  }
  .proposal-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .proposal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    align-items: center;
  }
  .proposal-name { font-weight: 600; font-size: 1rem; color: var(--text); }
  .proposal-phone {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--telegram);
  }
  .proposal-message {
    width: 100%;
    min-height: 70px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.65rem 0.85rem;
    resize: vertical;
    outline: none;
  }
  .proposal-message:focus { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-dim); }
  .proposal-message[readonly] { opacity: 0.85; }

  .proposal-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }
  .proposal-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .reasoning-toggle {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 0;
    font-family: var(--font-body);
  }
  .reasoning-toggle:hover { color: var(--text); }
  .reasoning-block {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    display: none;
    white-space: pre-wrap;
  }
  .reasoning-block.show { display: block; }
  .badge {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 500;
    font-family: var(--font-mono);
  }
  .badge-stale { background: var(--yellow-dim); color: var(--yellow); }
  .badge-reason { background: var(--surface-2); color: var(--text-muted); }
  .empty-state-small {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }
  .worker-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.82rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }
  .worker-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--text-muted);
  }
  .worker-dot.green { background: var(--green); }
  .worker-dot.yellow { background: var(--yellow); }
  .worker-dot.red { background: var(--red); }
  .worker-bar .spacer { flex: 1 1 auto; }
  .worker-bar .pause-btn {
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
    font-family: var(--font-body);
    cursor: pointer;
    font-size: 0.78rem;
  }
  .worker-bar .pause-btn:hover { border-color: var(--accent); }
  .pause-banner {
    display: none;
    background: var(--yellow-dim);
    color: var(--yellow);
    border: 1px solid var(--yellow);
    border-radius: var(--radius);
    padding: 0.6rem 0.85rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }
  .pause-banner.show { display: block; }
  .proposal.focus-pulse {
    animation: focus-pulse 2.5s ease-in-out;
    border-color: var(--accent);
  }
  @keyframes focus-pulse {
    0% { box-shadow: 0 0 0 0 var(--accent); }
    50% { box-shadow: 0 0 0 6px var(--accent-dim); }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .default-image-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .default-image-thumb {
    width: 80px;
    height: 80px;
    border-radius: 6px;
    object-fit: cover;
    background: var(--bg);
    border: 1px solid var(--border);
    cursor: pointer;
  }
  .default-image-thumb.empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }
  .default-image-meta { display: flex; flex-direction: column; gap: 0.15rem; flex: 1 1 200px; min-width: 0; }
  .default-image-meta .name { font-size: 0.92rem; color: var(--text); }
  .default-image-meta .sub { font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono); }
  .default-image-actions { display: flex; gap: 0.5rem; }
  .image-setup-banner {
    background: var(--red);
    color: var(--bg);
    border-radius: var(--radius);
    padding: 0.6rem 0.85rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .image-setup-banner.hidden { display: none; }
  .lightbox-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    cursor: zoom-out;
  }
  .lightbox-backdrop.show { display: flex; }
  .lightbox-backdrop img { max-width: 92vw; max-height: 92vh; }
  .image-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.4rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    flex-wrap: wrap;
    font-size: 0.78rem;
  }
  .image-bar .thumb {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    object-fit: cover;
    background: var(--surface-2);
    border: 1px solid var(--border);
    cursor: pointer;
    flex: 0 0 auto;
  }
  .image-bar .label { color: var(--text-muted); flex: 1 1 auto; min-width: 80px; }
  .image-bar .label.custom { color: var(--accent); }
  .image-bar .actions { display: flex; gap: 0.4rem; }
  .image-bar .icon-btn {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    border-radius: 4px;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.78rem;
  }
  .image-bar .icon-btn:hover { border-color: var(--accent); }
  .image-bar .icon-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .image-bar .counter {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    flex: 0 0 auto;
  }
  .image-bar .counter.green { color: var(--green); }
  .image-bar .counter.yellow { color: var(--yellow); }
  .image-bar .counter.red { color: var(--red); }
</style>

<div class="outreach-wrap">
  <div class="image-setup-banner hidden" id="image-setup-banner">⚠ Upload a default brand image below to enable outreach.</div>
  <div class="default-image-card">
    <img class="default-image-thumb" id="default-image-thumb" alt="Default brand image" onclick="openLightbox()">
    <div class="default-image-meta">
      <div class="name" id="default-image-name">Loading…</div>
      <div class="sub" id="default-image-sub"></div>
    </div>
    <div class="default-image-actions">
      <input type="file" id="default-image-file" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="uploadDefaultImage(event)">
      <button class="btn btn-primary" onclick="document.getElementById('default-image-file').click()">Replace image</button>
    </div>
  </div>
  <div class="lightbox-backdrop" id="lightbox" onclick="closeLightbox()">
    <img id="lightbox-img" alt="Full size">
  </div>
  <div class="pause-banner" id="pause-banner">⏸ Worker is paused. Approved proposals will queue until resumed.</div>
  <div class="worker-bar" id="worker-bar">
    <span class="worker-dot" id="worker-dot"></span>
    <span id="worker-summary">Worker: checking…</span>
    <span class="spacer"></span>
    <button class="pause-btn" id="pause-btn" onclick="togglePause()">Pause</button>
  </div>
  <div class="outreach-top">
    <div class="status-tabs" id="status-tabs">
      <button class="status-tab active" data-status="pending">Pending <span class="count" data-count="pending">0</span></button>
      <button class="status-tab" data-status="approved">Approved <span class="count" data-count="approved">0</span></button>
      <button class="status-tab" data-status="in_flight">In Flight <span class="count" data-count="in_flight">0</span></button>
      <button class="status-tab" data-status="sent">Sent <span class="count" data-count="sent">0</span></button>
      <button class="status-tab" data-status="skipped">Skipped <span class="count" data-count="skipped">0</span></button>
      <button class="status-tab" data-status="failed">Failed <span class="count" data-count="failed">0</span></button>
    </div>
    <div class="generate-bar">
      <input type="number" id="gen-limit" value="10" min="1" max="50" style="width:70px" title="Max proposals to create">
      <button class="btn btn-ghost" onclick="openTestPrompt()">Test on me (kasing / Chan kasing)</button>
      <button class="btn btn-primary" id="gen-batch-btn" onclick="generateBatch()">Generate batch</button>
      <button class="btn btn-ghost" style="color:var(--red);border-color:var(--red)" onclick="clearAll()">Clear all</button>
    </div>
  </div>

  <div id="list">
    <div class="empty-state-small">Loading…</div>
  </div>
</div>

<script>
  const API = '/crm/api/outreach';
  const DEFAULT_IMAGE_URL = API + '/default-image';
  let hasDefaultImage = false;
  let defaultImageBlobUrl = null;

  async function refreshDefaultImage() {
    const thumb = document.getElementById('default-image-thumb');
    const name = document.getElementById('default-image-name');
    const sub = document.getElementById('default-image-sub');
    const banner = document.getElementById('image-setup-banner');
    const genBtn = document.getElementById('gen-batch-btn');

    try {
      const resp = await fetch(DEFAULT_IMAGE_URL + '?cb=' + Date.now(), { credentials: 'same-origin' });
      if (resp.status === 404) {
        hasDefaultImage = false;
        thumb.removeAttribute('src');
        thumb.classList.add('empty');
        thumb.alt = '(none)';
        thumb.textContent = '(none)';
        name.textContent = 'No default image set';
        sub.textContent = 'Upload one to enable outreach';
        banner.classList.remove('hidden');
        if (genBtn) genBtn.disabled = true;
        return;
      }
      if (!resp.ok) throw new Error('GET default-image ' + resp.status);
      hasDefaultImage = true;
      const blob = await resp.blob();
      thumb.classList.remove('empty');
      if (defaultImageBlobUrl) URL.revokeObjectURL(defaultImageBlobUrl);
      defaultImageBlobUrl = URL.createObjectURL(blob);
      thumb.src = defaultImageBlobUrl;
      thumb.textContent = '';
      const filename = decodeURIComponent(resp.headers.get('x-filename') || 'image');
      const sizeKb = Math.round(blob.size / 1024);
      name.textContent = filename;
      sub.textContent = blob.type + ' · ' + sizeKb + ' KB';
      banner.classList.add('hidden');
      if (genBtn) genBtn.disabled = false;
    } catch (err) {
      console.error('refreshDefaultImage', err);
    }
  }

  async function uploadDefaultImage(ev) {
    const file = ev.target.files && ev.target.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('file', file);
    showToast('Uploading…', 'success');
    try {
      const resp = await fetch(DEFAULT_IMAGE_URL, { method: 'POST', credentials: 'same-origin', body: fd });
      const data = await resp.json().catch(() => ({}));
      if (resp.ok) { showToast('Default image updated', 'success'); refreshDefaultImage(); }
      else { showToast(data.error || ('Upload failed: ' + resp.status), 'error'); }
    } catch (err) {
      showToast('Upload failed', 'error');
    } finally {
      ev.target.value = '';
    }
  }

  function openLightbox() {
    if (!hasDefaultImage) return;
    const lb = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    img.src = document.getElementById('default-image-thumb').src;
    lb.classList.add('show');
  }
  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('show');
  }

  let currentStatus = 'pending';
  let pollTimer = null;
  let workerStatusTimer = null;
  let workerPaused = false;
  const focusId = (new URL(window.location.href)).searchParams.get('focus');

  document.querySelectorAll('#status-tabs .status-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#status-tabs .status-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentStatus = tab.dataset.status;
      loadList();
    });
  });

  async function loadList() {
    try {
      const resp = await fetch(API + '?status=' + encodeURIComponent(currentStatus) + '&limit=200', { credentials: 'same-origin' });
      if (resp.status === 401) { window.location.href = '/login'; return; }
      const data = await resp.json();
      applyCounts(data.counts || {});
      renderProposals(data.proposals || []);
    } catch (err) {
      document.getElementById('list').innerHTML = '<div class="empty-state-small">Failed to load.</div>';
    }
    schedulePoll();
  }

  function schedulePoll() {
    if (pollTimer) clearTimeout(pollTimer);
    const tabsToPoll = ['pending', 'approved', 'in_flight'];
    if (tabsToPoll.includes(currentStatus)) {
      pollTimer = setTimeout(loadList, 10000);
    }
  }

  function applyCounts(counts) {
    Object.entries(counts).forEach(([status, count]) => {
      const el = document.querySelector('.count[data-count="' + status + '"]');
      if (el) el.textContent = count;
    });
  }

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c])); }

  function counterClass(len) {
    if (len > 4096) return 'red';
    if (len > 1024) return 'yellow';
    return 'green';
  }
  function updateCounter(id) {
    const ta = document.getElementById('m-' + id);
    const counter = document.getElementById('counter-' + id);
    if (!ta || !counter) return;
    const len = ta.value.length;
    counter.textContent = len + ' / 1024';
    counter.classList.remove('green', 'yellow', 'red');
    counter.classList.add(counterClass(len));
    counter.title = len > 1024 && len <= 4096
      ? 'Will send as image then separate text — over caption limit.'
      : (len > 4096 ? 'Too long for Telegram — shorten before approving.' : '');

    // Disable Save and Approve when over 4096
    const card = document.getElementById('p-' + id);
    if (!card) return;
    const buttons = card.querySelectorAll('.proposal-actions .btn-primary');
    buttons.forEach((b) => { b.disabled = len > 4096; });
  }

  async function uploadCustomImage(id, ev) {
    const file = ev.target.files && ev.target.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('file', file);
    showToast('Uploading…', 'success');
    try {
      const resp = await fetch(API + '/' + id + '/image', { method: 'POST', credentials: 'same-origin', body: fd });
      const data = await resp.json().catch(() => ({}));
      if (resp.ok) {
        showToast('Custom image attached', 'success');
        const thumb = document.getElementById('img-' + id);
        const label = document.getElementById('img-label-' + id);
        const clearBtn = document.getElementById('img-clear-' + id);
        if (thumb) thumb.src = API + '/' + id + '/effective-image?cb=' + Date.now();
        if (label) { label.textContent = 'Custom image'; label.classList.add('custom'); }
        if (clearBtn) clearBtn.disabled = false;
      } else {
        showToast(data.error || ('Upload failed: ' + resp.status), 'error');
      }
    } catch (err) {
      showToast('Upload failed', 'error');
    } finally {
      ev.target.value = '';
    }
  }

  async function clearCustomImage(id) {
    try {
      const resp = await fetch(API + '/' + id + '/image', { method: 'DELETE', credentials: 'same-origin' });
      const data = await resp.json().catch(() => ({}));
      if (resp.ok) {
        showToast('Reverted to default', 'success');
        const thumb = document.getElementById('img-' + id);
        const label = document.getElementById('img-label-' + id);
        const clearBtn = document.getElementById('img-clear-' + id);
        if (thumb) thumb.src = API + '/' + id + '/effective-image?cb=' + Date.now();
        if (label) { label.textContent = 'Default image'; label.classList.remove('custom'); }
        if (clearBtn) clearBtn.disabled = true;
      } else {
        showToast(data.error || ('Revert failed: ' + resp.status), 'error');
      }
    } catch (err) {
      showToast('Revert failed', 'error');
    }
  }

  function openProposalLightbox(id) {
    const lb = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    img.src = API + '/' + id + '/effective-image?cb=' + Date.now();
    lb.classList.add('show');
  }

  function actionsHtml(p) {
    if (p.status === 'pending') {
      return (
        '<button class="btn btn-primary" onclick="saveEdit(\'' + p._id + '\')">Save draft edit</button>' +
        '<button class="btn btn-primary" onclick="approve(\'' + p._id + '\')">Approve</button>' +
        '<button class="btn btn-ghost" onclick="skip(\'' + p._id + '\')">Skip</button>'
      );
    }
    if (p.status === 'approved') {
      return '<button class="btn btn-ghost" onclick="skip(\'' + p._id + '\')">Cancel / Skip</button>';
    }
    return '';
  }

  function statusBadge(p) {
    const color = {
      pending: 'var(--text-muted)',
      approved: 'var(--accent)',
      in_flight: 'var(--yellow)',
      sent: 'var(--green)',
      skipped: 'var(--text-muted)',
      failed: 'var(--red)',
    }[p.status] || 'var(--text-muted)';
    return '<span class="badge" style="color:' + color + ';border:1px solid ' + color + '55">' + p.status + '</span>';
  }

  function maybeFocus() {
    if (!focusId) return;
    const el = document.getElementById('p-' + focusId);
    if (!el) return;
    el.classList.add('focus-pulse');
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function renderProposals(proposals) {
    const list = document.getElementById('list');
    if (proposals.length === 0) {
      list.innerHTML = '<div class="empty-state-small">No ' + currentStatus.replace('_',' ') + ' proposals.</div>';
      return;
    }
    list.innerHTML = proposals.map(p => {
      const daysBadge = p.days_since_contact != null ? '<span class="badge badge-stale">' + p.days_since_contact + 'd stale</span>' : '';
      const reasonBadge = p.reason_code ? '<span class="badge badge-reason">' + esc(p.reason_code) + '</span>' : '';
      const phoneLink = '<a href="https://t.me/' + encodeURIComponent(p.customer_phone) + '" target="_blank" class="proposal-phone">' + esc(p.customer_phone) + '</a>';
      const editable = p.status === 'pending' ? '' : 'readonly';
      const customClass = p.custom_image_id ? 'custom' : '';
      const customLabel = p.custom_image_id ? 'Custom image' : 'Default image';
      const customDisabled = p.custom_image_id ? '' : 'disabled';
      const imageBarReadonly = p.status === 'pending' ? '' : 'disabled';
      const statusTail = p.status === 'skipped' && p.skipped_reason ? '<span>· ' + esc(p.skipped_reason) + '</span>' : '';
      const failedTail = p.status === 'failed' && p.failed_reason ? '<span>· ' + esc(p.failed_reason) + '</span>' : '';
      const approvedTail = p.approved_by ? '<span>· approved by ' + esc(p.approved_by) + '</span>' : '';
      return (
        '<div class="proposal" id="p-' + p._id + '">' +
          '<div class="proposal-top">' +
            '<div>' +
              '<div class="proposal-name">' + esc(p.customer_name || 'Unknown') + '</div>' +
              '<div class="proposal-meta">' + phoneLink + ' ' + daysBadge + ' ' + reasonBadge + ' ' + (p.follower ? '<span>follower: ' + esc(p.follower) + '</span>' : '') + '</div>' +
            '</div>' +
            '<div>' + statusBadge(p) + '</div>' +
          '</div>' +
          '<textarea class="proposal-message" id="m-' + p._id + '" ' + editable + '>' + esc(p.message) + '</textarea>' +
          '<div class="image-bar">' +
            '<img class="thumb" id="img-' + p._id + '" src="' + esc(API + '/' + p._id + '/effective-image?v=' + (p.custom_image_id || 'default')) + '" onclick="openProposalLightbox(\'' + p._id + '\')" alt="image">' +
            '<span class="label ' + customClass + '" id="img-label-' + p._id + '">' + customLabel + '</span>' +
            '<input type="file" id="img-file-' + p._id + '" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="uploadCustomImage(\'' + p._id + '\', event)">' +
            '<div class="actions">' +
              '<button class="icon-btn" onclick="document.getElementById(\'img-file-' + p._id + '\').click()" ' + imageBarReadonly + '>📎 Replace</button>' +
              '<button class="icon-btn" onclick="clearCustomImage(\'' + p._id + '\')" ' + customDisabled + ' ' + imageBarReadonly + ' id="img-clear-' + p._id + '">↺ Use default</button>' +
            '</div>' +
            '<span class="counter" id="counter-' + p._id + '">0 / 1024</span>' +
          '</div>' +
          '<div class="proposal-actions">' + actionsHtml(p) + '</div>' +
          '<div class="proposal-footer">' +
            '<button class="reasoning-toggle" onclick="toggleReason(\'' + p._id + '\')">Show reasoning</button>' +
            '<div>' + new Date(p.created_at).toLocaleString() + ' ' + approvedTail + ' ' + statusTail + ' ' + failedTail + '</div>' +
          '</div>' +
          '<div class="reasoning-block" id="r-' + p._id + '">' + esc(p.reasoning || '') + '</div>' +
        '</div>'
      );
    }).join('');
    proposals.forEach((p) => {
      const ta = document.getElementById('m-' + p._id);
      if (ta) {
        ta.addEventListener('input', () => updateCounter(p._id));
        updateCounter(p._id);
      }
    });
    setTimeout(maybeFocus, 50);
  }

  function toggleReason(id) {
    const block = document.getElementById('r-' + id);
    if (!block) return;
    block.classList.toggle('show');
  }

  async function saveEdit(id) {
    const msg = document.getElementById('m-' + id).value;
    try {
      const resp = await fetch(API + '/' + id, {
        method: 'PATCH',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg }),
      });
      if (resp.ok) showToast('Draft saved', 'success'); else showToast('Save failed', 'error');
    } catch { showToast('Save failed', 'error'); }
  }

  async function approve(id) {
    await saveEdit(id);
    try {
      const resp = await fetch(API + '/' + id + '/approve', { method: 'POST', credentials: 'same-origin' });
      if (resp.ok) { showToast('Approved', 'success'); loadList(); }
      else showToast('Approve failed', 'error');
    } catch { showToast('Approve failed', 'error'); }
  }

  async function skip(id) {
    const reason = prompt('Skip reason?', 'not relevant');
    if (reason == null) return;
    try {
      const resp = await fetch(API + '/' + id + '/skip', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason }),
      });
      if (resp.ok) { showToast('Skipped', 'success'); loadList(); }
      else showToast('Skip failed', 'error');
    } catch { showToast('Skip failed', 'error'); }
  }

  async function generateBatch() {
    const limit = parseInt(document.getElementById('gen-limit').value, 10) || 10;
    if (!confirm('Generate ' + limit + ' outreach drafts for stale (45d+) leads?')) return;
    await postGenerate({ limit });
  }

  async function openTestPrompt() {
    if (!confirm('Generate drafts targeted at kasing (+85570597666) and Chan kasing (+85511228226)?')) return;
    await postGenerate({ phones: ['+85570597666', '+85511228226'] });
  }

  async function postGenerate(body) {
    showToast('Generating…', 'success');
    try {
      const resp = await fetch(API + '/generate', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await resp.json();
      if (!resp.ok) { showToast(data.error || 'Generate failed', 'error'); return; }
      showToast('Created ' + data.created + ', skipped ' + data.skipped, 'success');
      currentStatus = 'pending';
      document.querySelectorAll('#status-tabs .status-tab').forEach(t => t.classList.toggle('active', t.dataset.status === 'pending'));
      loadList();
    } catch (err) {
      showToast('Generate failed', 'error');
    }
  }

  async function clearAll() {
    if (!confirm('Delete ALL outreach proposals (every status)? This cannot be undone.')) return;
    try {
      const resp = await fetch(API + '/all', { method: 'DELETE', credentials: 'same-origin' });
      const data = await resp.json();
      if (resp.ok) { showToast('Deleted ' + data.deleted + ' proposals', 'success'); loadList(); }
      else showToast(data.error || 'Delete failed', 'error');
    } catch { showToast('Delete failed', 'error'); }
  }

  function fmtTimeAgo(iso) {
    if (!iso) return 'never';
    const t = new Date(iso).getTime();
    if (!Number.isFinite(t)) return 'never';
    const secs = Math.max(0, Math.floor((Date.now() - t) / 1000));
    if (secs < 60) return secs + 's ago';
    if (secs < 3600) return Math.floor(secs / 60) + 'm ago';
    if (secs < 86400) return Math.floor(secs / 3600) + 'h ago';
    return Math.floor(secs / 86400) + 'd ago';
  }

  async function refreshWorkerStatus() {
    try {
      const resp = await fetch(API + '/worker-status', { credentials: 'same-origin' });
      if (!resp.ok) return;
      const data = await resp.json();
      workerPaused = !!data.paused;

      const dot = document.getElementById('worker-dot');
      const summary = document.getElementById('worker-summary');
      const banner = document.getElementById('pause-banner');
      const btn = document.getElementById('pause-btn');

      const heartbeatMs = data.last_heartbeat_at ? (Date.now() - new Date(data.last_heartbeat_at).getTime()) : Infinity;
      let color = 'red';
      if (heartbeatMs < 2 * 60_000) color = 'green';
      else if (heartbeatMs < 5 * 60_000) color = 'yellow';
      dot.classList.remove('green', 'yellow', 'red');
      dot.classList.add(color);

      const sentLine = (data.sent_today || 0) + '/' + (data.daily_cap || 15) + ' sent today';
      const heartbeatLine = 'last heartbeat ' + fmtTimeAgo(data.last_heartbeat_at);
      const workerLine = data.worker_id ? ('worker: ' + data.worker_id + ' · ') : '';
      const errLine = data.last_error ? (' · last error: ' + data.last_error) : '';
      summary.textContent = workerLine + heartbeatLine + ' · ' + sentLine + errLine;

      banner.classList.toggle('show', workerPaused);
      btn.textContent = workerPaused ? 'Resume' : 'Pause';
    } catch {
      // ignore — next tick
    }
  }

  async function togglePause() {
    try {
      const resp = await fetch(API + '/pause', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ paused: !workerPaused }),
      });
      if (resp.ok) refreshWorkerStatus();
      else showToast('Pause toggle failed', 'error');
    } catch { showToast('Pause toggle failed', 'error'); }
  }

  function startWorkerStatusPoll() {
    refreshWorkerStatus();
    if (workerStatusTimer) clearInterval(workerStatusTimer);
    workerStatusTimer = setInterval(refreshWorkerStatus, 10000);
  }

  refreshDefaultImage();
  startWorkerStatusPoll();
  loadList();
</script>

