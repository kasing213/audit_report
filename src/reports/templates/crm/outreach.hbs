{{> head title="Sales CRM — Outreach"}}
{{> nav activeNav="outreach"}}

<style>
  .outreach-wrap { padding: 1.25rem; max-width: 1200px; margin: 0 auto; }
  .outreach-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .status-tabs { display: flex; gap: 0.25rem; flex-wrap: wrap; }
  .status-tab {
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.15s;
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .status-tab:hover { color: var(--text); border-color: var(--text-muted); }
  .status-tab.active { color: var(--accent); border-color: var(--accent); background: var(--accent-dim); }
  .status-tab .count {
    background: var(--surface-2);
    border-radius: 10px;
    padding: 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .status-tab.active .count { background: var(--bg); color: var(--accent); }

  .generate-bar { display: flex; gap: 0.5rem; align-items: center; }

  .proposal {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    margin-bottom: 0.75rem;
  }
  .proposal-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .proposal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    align-items: center;
  }
  .proposal-name { font-weight: 600; font-size: 1rem; color: var(--text); }
  .proposal-phone {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--telegram);
  }
  .proposal-message {
    width: 100%;
    min-height: 70px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.65rem 0.85rem;
    resize: vertical;
    outline: none;
  }
  .proposal-message:focus { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-dim); }
  .proposal-message[readonly] { opacity: 0.85; }

  .proposal-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }
  .proposal-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .reasoning-toggle {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 0;
    font-family: var(--font-body);
  }
  .reasoning-toggle:hover { color: var(--text); }
  .reasoning-block {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    display: none;
    white-space: pre-wrap;
  }
  .reasoning-block.show { display: block; }
  .badge {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 500;
    font-family: var(--font-mono);
  }
  .badge-stale { background: var(--yellow-dim); color: var(--yellow); }
  .badge-reason { background: var(--surface-2); color: var(--text-muted); }
  .empty-state-small {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }
  .worker-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.82rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }
  .worker-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--text-muted);
  }
  .worker-dot.green { background: var(--green); }
  .worker-dot.yellow { background: var(--yellow); }
  .worker-dot.red { background: var(--red); }
  .worker-bar .spacer { flex: 1 1 auto; }
  .worker-bar .pause-btn {
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
    font-family: var(--font-body);
    cursor: pointer;
    font-size: 0.78rem;
  }
  .worker-bar .pause-btn:hover { border-color: var(--accent); }
  .worker-bar .mode-btn {
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
    font-family: var(--font-body);
    cursor: pointer;
    font-size: 0.78rem;
    margin-right: 0.4rem;
  }
  .worker-bar .mode-btn:hover { border-color: var(--accent); }
  .worker-bar .mode-btn.auto {
    border-color: var(--yellow);
    color: var(--yellow);
  }
  .schedule-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.75rem;
    padding: 0.75rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }
  .schedule-clock {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: var(--accent-dim);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1rem;
  }
  .schedule-copy { min-width: 0; }
  .schedule-title { color: var(--text); font-size: 0.9rem; font-weight: 600; }
  .schedule-help { color: var(--text-muted); font-size: 0.76rem; margin-top: 0.15rem; }
  .schedule-controls { display: flex; align-items: center; gap: 0.5rem; }
  .schedule-time {
    width: 7.4rem;
    padding: 0.42rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    color-scheme: dark;
    font: 600 0.85rem var(--font-mono);
    outline: none;
  }
  .schedule-time:focus { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-dim); }
  @media (max-width: 620px) {
    .schedule-card { grid-template-columns: auto minmax(0, 1fr); }
    .schedule-controls { grid-column: 1 / -1; }
    .schedule-time { flex: 1 1 auto; width: auto; }
  }
  .pause-banner {
    display: none;
    background: var(--yellow-dim);
    color: var(--yellow);
    border: 1px solid var(--yellow);
    border-radius: var(--radius);
    padding: 0.6rem 0.85rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }
  .pause-banner.show { display: block; }
  .proposal.focus-pulse {
    animation: focus-pulse 2.5s ease-in-out;
    border-color: var(--accent);
  }
  @keyframes focus-pulse {
    0% { box-shadow: 0 0 0 0 var(--accent); }
    50% { box-shadow: 0 0 0 6px var(--accent-dim); }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .default-image-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .default-image-thumb {
    width: 80px;
    height: 80px;
    border-radius: 6px;
    object-fit: cover;
    background: var(--bg);
    border: 1px solid var(--border);
    cursor: pointer;
  }
  .default-image-thumb.empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }
  .default-image-meta { display: flex; flex-direction: column; gap: 0.15rem; flex: 1 1 200px; min-width: 0; }
  .default-image-meta .name { font-size: 0.92rem; color: var(--text); }
  .default-image-meta .sub { font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono); }
  .default-image-actions { display: flex; gap: 0.5rem; }
  .lightbox-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    cursor: zoom-out;
  }
  .lightbox-backdrop.show { display: flex; }
  .lightbox-backdrop img { max-width: 92vw; max-height: 92vh; }
  .image-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.4rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    flex-wrap: wrap;
    font-size: 0.78rem;
  }
  .image-bar .thumb {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    object-fit: cover;
    background: var(--surface-2);
    border: 1px solid var(--border);
    cursor: pointer;
    flex: 0 0 auto;
  }
  .image-bar .label { color: var(--text-muted); flex: 1 1 auto; min-width: 80px; }
  .image-bar .label.custom { color: var(--accent); }
  .image-bar .actions { display: flex; gap: 0.4rem; }
  .image-bar .icon-btn {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    border-radius: 4px;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.78rem;
  }
  .image-bar .icon-btn:hover { border-color: var(--accent); }
  .image-bar .icon-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .image-bar .counter {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    flex: 0 0 auto;
  }
  .image-bar .counter.green { color: var(--green); }
  .image-bar .counter.yellow { color: var(--yellow); }
  .image-bar .counter.red { color: var(--red); }
  .extra-media-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
    align-items: center;
  }
  .extra-media-item {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
  }
  .extra-media-item img { width: 100%; height: 100%; object-fit: cover; }
  .extra-media-item .remove-btn {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    border: none;
    cursor: pointer;
    font-size: 0.7rem;
    line-height: 1;
  }
  .media-budget-readout {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
</style>

<div class="outreach-wrap">
  <div class="media-budget-readout" id="media-budget-readout">Loading media usage…</div>
  <div class="default-image-card">
    <img class="default-image-thumb" id="default-image-thumb" alt="Default brand image" onclick="openLightbox()">
    <div class="default-image-meta">
      <div class="name" id="default-image-name">Loading…</div>
      <div class="sub" id="default-image-sub"></div>
      <div class="extra-media-strip" id="extra-images-strip"></div>
    </div>
    <div class="default-image-actions">
      <input type="file" id="default-image-file" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="uploadDefaultImage(event)">
      <button class="btn btn-primary" onclick="document.getElementById('default-image-file').click()">Replace image</button>
      <button class="btn btn-ghost" id="default-image-remove" style="display:none;color:var(--red);border-color:var(--red)" onclick="removeDefaultImage()">Remove</button>
      <input type="file" id="extra-image-file" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="addExtraImage(event)">
      <button class="btn btn-ghost" id="add-extra-image-btn" onclick="document.getElementById('extra-image-file').click()">+ Add image</button>
    </div>
  </div>
  <div class="default-image-card" id="default-video-card">
    <div class="default-image-thumb empty" id="default-video-thumb">🎬</div>
    <div class="default-image-meta">
      <div class="name" id="default-video-name">Loading…</div>
      <div class="sub" id="default-video-sub"></div>
      <div class="extra-media-strip" id="extra-videos-strip"></div>
    </div>
    <div class="default-image-actions">
      <input type="file" id="default-video-file" accept="video/mp4" style="display:none" onchange="uploadDefaultVideo(event)">
      <button class="btn btn-primary" onclick="document.getElementById('default-video-file').click()">Replace video</button>
      <button class="btn btn-ghost" id="default-video-remove" style="display:none;color:var(--red);border-color:var(--red)" onclick="removeDefaultVideo()">Remove</button>
      <input type="file" id="extra-video-file" accept="video/mp4" style="display:none" onchange="addExtraVideo(event)">
      <button class="btn btn-ghost" id="add-extra-video-btn" onclick="document.getElementById('extra-video-file').click()">+ Add video</button>
    </div>
  </div>
  <div class="default-image-card" id="default-text-card" style="align-items:flex-start">
    <div class="default-image-meta" style="flex:1 1 100%">
      <div class="name" id="default-text-name">Default message text</div>
      <div class="sub" id="default-text-sub">Applies to newly generated proposals.</div>
      <textarea id="default-text-input" class="proposal-message" style="margin-top:0.5rem;min-height:120px" placeholder="Loading…"></textarea>
      <div class="image-bar" style="margin-top:0.4rem">
        <span class="label" id="default-text-source">—</span>
        <span class="counter" id="default-text-counter">0 / 1024</span>
        <div class="actions" style="margin-left:auto">
          <button class="btn btn-ghost" id="default-text-reset" onclick="resetDefaultText()">Reset to default</button>
          <button class="btn btn-primary" id="default-text-save" onclick="saveDefaultText()">Save</button>
        </div>
      </div>
    </div>
  </div>
  <div class="schedule-card" id="outreach-schedule-card">
    <div class="schedule-clock" aria-hidden="true">13</div>
    <div class="schedule-copy">
      <label class="schedule-title" for="outreach-daily-time">Daily outreach time</label>
      <div class="schedule-help" id="outreach-schedule-help">Cambodia time · applies to Company and Personal</div>
    </div>
    <div class="schedule-controls">
      <input class="schedule-time" type="time" id="outreach-daily-time" step="60" aria-describedby="outreach-schedule-help">
      <button class="btn btn-primary" id="outreach-schedule-save" onclick="saveOutreachSchedule()">Save time</button>
    </div>
  </div>
  <div class="lightbox-backdrop" id="lightbox" onclick="closeLightbox()">
    <img id="lightbox-img" alt="Full size">
  </div>
  <div class="pause-banner" id="pause-banner">⏸ Worker is paused. Approved proposals will queue until resumed.</div>
  <div class="worker-bar" id="worker-bar">
    <span class="worker-dot" id="worker-dot"></span>
    <span id="worker-summary">Worker: checking…</span>
    <span class="spacer"></span>
    <button class="mode-btn" id="mode-btn" onclick="toggleAutoApprove()">Approve: Manual</button>
    <button class="pause-btn" id="pause-btn" onclick="togglePause()">Pause</button>
  </div>
  <div class="outreach-top">
    <div class="status-tabs" id="status-tabs">
      <button class="status-tab active" data-status="pending">Pending <span class="count" data-count="pending">0</span></button>
      <button class="status-tab" data-status="approved">Approved <span class="count" data-count="approved">0</span></button>
      <button class="status-tab" data-status="in_flight">In Flight <span class="count" data-count="in_flight">0</span></button>
      <button class="status-tab" data-status="sent">Sent <span class="count" data-count="sent">0</span></button>
      <button class="status-tab" data-status="skipped">Skipped <span class="count" data-count="skipped">0</span></button>
      <button class="status-tab" data-status="failed">Failed <span class="count" data-count="failed">0</span></button>
    </div>
    <div class="generate-bar">
      <input type="number" id="gen-limit" value="20" min="1" max="50" style="width:70px" title="Max proposals to create">
      <button class="btn btn-ghost" onclick="openTestPrompt()">Test on me (kasing / Chan kasing)</button>
      <button class="btn btn-primary" id="gen-batch-btn" onclick="generateBatch()">Generate batch</button>
      <button class="btn btn-ghost" style="color:var(--red);border-color:var(--red)" onclick="clearAll()">Clear all</button>
    </div>
  </div>

  <div id="list">
    <div class="empty-state-small">Loading…</div>
  </div>
</div>

<script>
  const API = '/crm/api/outreach';
  const DEFAULT_IMAGE_URL = API + '/default-image';
  let hasDefaultImage = false;
  let defaultImageBlobUrl = null;

  async function refreshDefaultImage() {
    const thumb = document.getElementById('default-image-thumb');
    const name = document.getElementById('default-image-name');
    const sub = document.getElementById('default-image-sub');
    const genBtn = document.getElementById('gen-batch-btn');
    const removeBtn = document.getElementById('default-image-remove');

    try {
      const resp = await fetch(DEFAULT_IMAGE_URL + '?cb=' + Date.now(), { credentials: 'same-origin' });
      if (resp.status === 404) {
        hasDefaultImage = false;
        thumb.removeAttribute('src');
        thumb.classList.add('empty');
        thumb.alt = '(none)';
        thumb.textContent = '(none)';
        name.textContent = 'No default image set';
        // Media is optional: with no image the worker sends text (and video, if
        // set) only, so outreach stays enabled.
        sub.textContent = 'Optional — leads get text only';
        if (genBtn) genBtn.disabled = false;
        if (removeBtn) removeBtn.style.display = 'none';
        return;
      }
      if (!resp.ok) throw new Error('GET default-image ' + resp.status);
      hasDefaultImage = true;
      const blob = await resp.blob();
      thumb.classList.remove('empty');
      if (defaultImageBlobUrl) URL.revokeObjectURL(defaultImageBlobUrl);
      defaultImageBlobUrl = URL.createObjectURL(blob);
      thumb.src = defaultImageBlobUrl;
      thumb.textContent = '';
      const filename = decodeURIComponent(resp.headers.get('x-filename') || 'image');
      const sizeKb = Math.round(blob.size / 1024);
      name.textContent = filename;
      sub.textContent = blob.type + ' · ' + sizeKb + ' KB';
      if (genBtn) genBtn.disabled = false;
      if (removeBtn) removeBtn.style.display = '';
    } catch (err) {
      console.error('refreshDefaultImage', err);
    }
  }

  async function uploadDefaultImage(ev) {
    const file = ev.target.files && ev.target.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('file', file);
    showToast('Uploading…', 'success');
    try {
      const resp = await fetch(DEFAULT_IMAGE_URL, { method: 'POST', credentials: 'same-origin', body: fd });
      const data = await resp.json().catch(() => ({}));
      if (resp.ok) { showToast('Default image updated', 'success'); refreshDefaultImage(); }
      else { showToast(data.error || ('Upload failed: ' + resp.status), 'error'); }
    } catch (err) {
      showToast('Upload failed', 'error');
    } finally {
      ev.target.value = '';
    }
  }

  async function removeDefaultImage() {
    if (!confirm('Remove the default brand image? Outreach stays disabled for this workspace until you upload a new one.')) return;
    try {
      const resp = await fetch(DEFAULT_IMAGE_URL, { method: 'DELETE', credentials: 'same-origin' });
      if (resp.ok) { showToast('Default image removed', 'success'); refreshDefaultImage(); }
      else showToast('Remove failed', 'error');
    } catch { showToast('Remove failed', 'error'); }
  }

  const DEFAULT_VIDEO_URL = API + '/default-video';

  async function refreshDefaultVideo() {
    const thumb = document.getElementById('default-video-thumb');
    const name = document.getElementById('default-video-name');
    const sub = document.getElementById('default-video-sub');
    const removeBtn = document.getElementById('default-video-remove');
    try {
      const resp = await fetch(DEFAULT_VIDEO_URL + '?cb=' + Date.now(), { credentials: 'same-origin' });
      if (resp.status === 404) {
        name.textContent = 'No marketing video set';
        sub.textContent = 'Optional — leads get image + text only';
        thumb.textContent = '🎬';
        removeBtn.style.display = 'none';
        return;
      }
      if (!resp.ok) throw new Error('GET default-video ' + resp.status);
      const data = await resp.json();
      const sizeMb = (Number(data.size_bytes || 0) / (1024 * 1024)).toFixed(1);
      name.textContent = data.filename || 'video.mp4';
      sub.textContent = (data.mime_type || 'video/mp4') + ' · ' + sizeMb + ' MB';
      thumb.textContent = '🎬';
      removeBtn.style.display = '';
    } catch (err) {
      console.error('refreshDefaultVideo', err);
    }
  }

  async function uploadDefaultVideo(ev) {
    const file = ev.target.files && ev.target.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('file', file);
    showToast('Uploading video… (may take a moment)', 'success');
    try {
      const resp = await fetch(DEFAULT_VIDEO_URL, { method: 'POST', credentials: 'same-origin', body: fd });
      const data = await resp.json().catch(() => ({}));
      if (resp.ok) { showToast('Marketing video updated', 'success'); refreshDefaultVideo(); }
      else { showToast(data.error || ('Upload failed: ' + resp.status), 'error'); }
    } catch (err) {
      showToast('Upload failed', 'error');
    } finally {
      ev.target.value = '';
    }
  }

  async function removeDefaultVideo() {
    if (!confirm('Remove the marketing video? Leads will get image + text only.')) return;
    try {
      const resp = await fetch(DEFAULT_VIDEO_URL, { method: 'DELETE', credentials: 'same-origin' });
      if (resp.ok) { showToast('Video removed', 'success'); refreshDefaultVideo(); }
      else showToast('Remove failed', 'error');
    } catch { showToast('Remove failed', 'error'); }
  }

  const EXTRA_IMAGE_URL = API + '/default-image/extra';
