{{> head title="Sales CRM — Groups"}}
{{> nav activeNav="groups"}}

<div class="section-wrap">
  <h2 class="section-title">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-3px;margin-right:0.35rem"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75M9 11a4 4 0 100-8 4 4 0 000 8z"/></svg>
    Configured Telegram Groups
  </h2>
  <div style="overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)">
    <table class="customer-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Name</th>
          <th>Chat ID</th>
        </tr>
      </thead>
      <tbody id="groups-config-body">
        <tr><td colspan="3" style="color:var(--text-muted)">Loading...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  const API_BASE = '/crm';

  async function loadGroupsConfig() {
    try {
      const resp = await fetch(API_BASE + '/api/groups-config', { credentials: 'same-origin' });
      if (resp.status === 401) { window.location.href = '/login'; return; }
      const data = await resp.json();
      const rows = [];
      (data.sales || []).forEach(g => {
        rows.push('<tr><td><span class="tag" style="background:var(--accent-dim);color:var(--accent)">Sales</span></td><td>' + g.name + '</td><td style="font-family:var(--font-mono);font-size:0.8rem">' + g.chatId + '</td></tr>');
      });
      (data.admin || []).forEach(g => {
        rows.push('<tr><td><span class="tag" style="background:var(--yellow-dim);color:var(--yellow)">Manager</span></td><td>' + g.name + '</td><td style="font-family:var(--font-mono);font-size:0.8rem">' + g.chatId + '</td></tr>');
      });
      document.getElementById('groups-config-body').innerHTML = rows.length
        ? rows.join('')
        : '<tr><td colspan="3" style="color:var(--text-muted)">No groups configured</td></tr>';
    } catch (err) {
      document.getElementById('groups-config-body').innerHTML = '<tr><td colspan="3" style="color:var(--red)">Failed to load</td></tr>';
    }
  }

  loadGroupsConfig();
</script>

{{> footer}}
