{{> head title="Sales CRM — Import to Outreach"}}
{{> nav activeNav="import-outreach"}}

<style>
  .drop-zone {
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    padding: 3rem 2rem;
    text-align: center;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
    background: var(--surface);
  }
  .drop-zone:hover, .drop-zone.dragover {
    border-color: var(--accent);
    background: var(--accent-dim);
  }
  .drop-zone input { display: none; }
  .drop-zone p:first-of-type { color: var(--text); font-weight: 500; margin-bottom: 0.25rem; }

  .import-preview {
    margin-top: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    display: none;
  }
  .import-preview.show { display: block; }
  .import-preview h4 { font-size: 0.9rem; margin-bottom: 0.5rem; }
  .import-actions { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
  .callout {
    margin-top: 0.75rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius);
    background: var(--accent-dim);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text);
  }
</style>

<div class="section-wrap">
  <h2 class="section-title">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-3px;margin-right:0.35rem"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
    Import → Outreach Pending
  </h2>
  <div class="callout">
    For old QuickBook phone lists with <strong>no sales name</strong>. Rows with no phone number are skipped, leads are dated 45 days back, and every imported number is pushed straight into the <a href="/crm/outreach">Outreach</a> <strong>Pending</strong> tab for approval.
  </div>
  <div class="drop-zone" id="drop-zone" onclick="document.getElementById('file-input').click()" style="margin-top:0.75rem">
    <input type="file" id="file-input" accept=".csv,.xlsx,.xls">
    <p>Click or drop the QuickBook Excel file here</p>
    <p style="font-size:0.75rem;margin-top:0.25rem">Auto-detects the "ID-Name Phone" format (no header)</p>
  </div>
  <div class="import-preview" id="import-preview">
    <h4>Preview: <span id="import-count">0</span> leads → will be staged as pending outreach</h4>
    <div style="overflow-x:auto;max-height:320px;font-size:0.8rem;font-family:var(--font-mono)" id="import-preview-table"></div>
    <div class="import-actions">
      <button class="btn btn-primary" onclick="confirmImport()">Import &amp; Push to Outreach</button>
      <button class="btn btn-ghost" onclick="cancelImport()">Cancel</button>
    </div>
  </div>
</div>

<script>
  const API_BASE = '/crm';
  let importRows = null;

  const dropZone = document.getElementById('drop-zone');
  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer.files.length) uploadFile(e.dataTransfer.files[0]);
  });
  document.getElementById('file-input').addEventListener('change', function() {
    if (this.files.length) uploadFile(this.files[0]);
  });

  async function uploadFile(file) {
    const formData = new FormData();
    formData.append('file', file);

    try {
      const resp = await fetch(API_BASE + '/api/import', {
        method: 'POST',
        credentials: 'same-origin',
        body: formData
      });
      if (resp.status === 401) { window.location.href = '/login'; return; }
      const data = await resp.json();

      if (data.error) {
        showToast(data.error, 'error');
        return;
      }

      importRows = data.rows;
      document.getElementById('import-count').textContent = data.total;

      const headers = data.headers || [];
      const sample = data.sample || [];
      let html = '<table style="width:100%;border-collapse:collapse"><thead><tr>';
      headers.forEach(h => html += '<th style="padding:0.25rem 0.5rem;border-bottom:1px solid var(--border);text-align:left">' + h + '</th>');
      html += '</tr></thead><tbody>';
      sample.forEach(row => {
        html += '<tr>';
        headers.forEach(h => html += '<td style="padding:0.25rem 0.5rem;border-bottom:1px solid var(--border)">' + (row[h] || '') + '</td>');
        html += '</tr>';
      });
      if (data.total > 5) html += '<tr><td colspan="' + headers.length + '" style="padding:0.25rem 0.5rem;color:var(--text-muted)">... and ' + (data.total - 5) + ' more rows</td></tr>';
      html += '</tbody></table>';

      document.getElementById('import-preview-table').innerHTML = html;
      document.getElementById('import-preview').classList.add('show');
    } catch (err) {
      showToast('Failed to upload file', 'error');
    }
  }

  async function confirmImport() {
    if (!importRows) return;
    try {
      const resp = await fetch(API_BASE + '/api/import/confirm-outreach', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rows: importRows })
      });
      if (resp.status === 401) { window.location.href = '/login'; return; }
      const data = await resp.json();
      if (data.success) {
        showToast('Imported ' + data.imported + ' · staged ' + data.staged + ' pending' + (data.staged_skipped ? ', ' + data.staged_skipped + ' already queued' : ''), 'success');
        cancelImport();
      } else {
        showToast(data.error || 'Import failed', 'error');
      }
    } catch (err) {
      showToast('Import failed', 'error');
    }
  }

  function cancelImport() {
    importRows = null;
    document.getElementById('import-preview').classList.remove('show');
    document.getElementById('file-input').value = '';
  }
</script>

{{> footer}}
