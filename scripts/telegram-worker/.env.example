# Copy to .env and fill in. Never commit .env.

# Base URL of the deployed CRM (Railway).
BASE_URL=https://auditreport-production.up.railway.app

# Restricted Bearer for outreach worker endpoints only (claim, mark-sent,
# mark-failed, worker-heartbeat, worker-alert, worker-status, report-inbound).
# MUST differ from the server's DASHBOARD_TOKEN — if they match, the server
# logs a warning and refuses to downgrade to the agent role.
# Generate with: openssl rand -hex 32
#
# Legacy WORKER_TOKEN is still accepted as a fallback; the server logs a
# deprecation warning. Prefer AGENT_TOKEN going forward.
AGENT_TOKEN=your-agent-token

# Telegram MTProto credentials. Get from https://my.telegram.org/apps (free).
# These identify the *app*, not the user account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Path to the StringSession blob (written by `npm run login`, read by `npm run start`).
# When running on Railway with a /data volume, set this to /data/telegram-string-session.txt
# so it survives redeploys.
STRING_SESSION_PATH=./telegram-string-session.txt

# Max outbound messages per UTC day. Safe starting point.
DAILY_CAP=15

# Random delay between sends, seconds.
MIN_DELAY_SEC=60
MAX_DELAY_SEC=180

# Optional: disable the inbound NewMessage listener (sends-only mode).
# INBOUND_DISABLED=true

# Optional: distinct identifier for this worker instance (shown on the dashboard).
# Defaults to <hostname>-<pid> if unset.
# WORKER_ID=
#
# Pause is controlled server-side now via the Outreach UI Pause/Resume button —
# no PAUSE env flag is read here.
