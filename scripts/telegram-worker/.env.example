# Copy to .env and fill in. Never commit .env.

# Base URL of the deployed CRM (Railway).
BASE_URL=https://auditreport-production.up.railway.app

# Restricted Bearer for outreach send-loop endpoints only (claim, mark-sent,
# mark-failed, worker-heartbeat, worker-alert, worker-status). MUST differ from
# the server's DASHBOARD_TOKEN — if they match, the server logs a warning and
# refuses to downgrade to the agent role. Generate with: openssl rand -hex 32
#
# Legacy WORKER_TOKEN is still accepted as a fallback; the server logs a
# deprecation warning. Prefer AGENT_TOKEN going forward.
AGENT_TOKEN=your-agent-token

# Path to the Playwright storage state (written by `npm run login`, read by `npm run start`).
# When running on Railway with a /data volume, set this to /data/telegram-session.json
# so it survives redeploys.
STORAGE_STATE=./telegram-session.json

# Max outbound messages per UTC day. Safe starting point.
DAILY_CAP=15

# Random delay between sends, seconds.
MIN_DELAY_SEC=60
MAX_DELAY_SEC=180

# Optional: distinct identifier for this worker instance (shown on the dashboard).
# Defaults to <hostname>-<pid> if unset.
# WORKER_ID=
#
# Pause is controlled server-side now via the Outreach UI Pause/Resume button —
# no PAUSE env flag is read here.
